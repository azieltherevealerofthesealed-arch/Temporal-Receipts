{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temporal Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "timestamp_utc",
    "event_type",
    "event_summary",
    "sources",
    "confidence_score",
    "hash_current"
  ],
  "properties": {
    "receipt_id": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "event_type": { "type": "string" },
    "event_summary": { "type": "string", "maxLength": 240 },
    "location": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "reference", "confidence"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["primary", "secondary", "tertiary", "witness", "artifact", "dataset"]
          },
          "reference": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "hash_sha256": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "hash_prev": { "type": ["string", "null"] },
    "hash_current": { "type": "string" },
    "links": {
      "type": "object",
      "properties": {
        "disputes": { "type": "array", "items": { "type": "string" } },
        "corrections": { "type": "array", "items": { "type": "string" } },
        "corroborations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "notes": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "additionalProperties": false
}
